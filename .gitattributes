# 换行符统一：仓库内容与工作区检出（含 Windows）一律使用 LF
* text=auto eol=lf

# 二进制文件：不做换行符转换，也不做文本 diff
*.png   -text
*.jpg   -text
*.jpeg  -text
*.gif   -text
*.bmp   -text
*.webp  -text
*.ico   -text
*.icns  -text
*.pdf   -text
*.zip   -text
*.exe   -text
*.pt    -text
*.ttf   -text
*.otf   -text
*.woff  -text
*.woff2 -text
